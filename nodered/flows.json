    {
        "id": "4c23debec8623f55",
        "type": "function",
        "z": "738d9d88112e823c",
        "name": "Filter data",
        "func": "const distance = Number(msg.payload.distance_cm);\n\nif (isNaN(distance)) {\n    node.error(\"distance_cm bukan angka\", msg);\n    return null;\n}\n\n// Ambil buffer\nlet buffer = context.get(\"buffer\") || [];\n\n// Tambahkan data baru\nbuffer.push(distance);\n\n// Simpan 5 data terakhir\nif (buffer.length > 5) {\n    buffer.shift();\n}\n\ncontext.set(\"buffer\", buffer);\n\n// Urutkan untuk mencari median\nconst sorted = [...buffer].sort((a, b) => a - b);\n\n// Median\nconst median = sorted[Math.floor(sorted.length / 2)];\n\n// Ganti distance dengan hasil filter\nmsg.payload.distance_cm = Number(median.toFixed(2));\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
