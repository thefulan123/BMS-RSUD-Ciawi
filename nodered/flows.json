    {
        "id": "692cfcd68b646870",
        "type": "function",
        "z": "738d9d88112e823c",
        "name": "Konversi jarak ke volume",
        "func": "// Ambil jarak\nconst distance = Number(msg.payload.distance_cm);\n\n// Data kalibrasi\nconst calibration = [\n    { d: 4.19, v: 1000 },\n    { d: 5.625, v: 900 },\n    { d: 6.10, v: 800 },\n    { d: 8.66, v: 600 },\n    { d: 10.00, v: 500 },\n    { d: 11.34, v: 400 },\n    { d: 12.66, v: 300 },\n    { d: 14.00, v: 200 },\n    { d: 15.35, v: 100 },\n    { d: 16.02, v: 0 }\n];\n\n// Validasi\nif (isNaN(distance)) {\n    node.error(\"distance_cm bukan angka\", msg);\n    return null;\n}\n\nlet volume;\n\n// Di bawah batas minimum\nif (distance <= calibration[0].d) {\n    volume = 1000;\n}\n\n// Di atas batas maksimum\nelse if (distance >= calibration[calibration.length - 1].d) {\n    volume = 0;\n}\n\n// Interpolasi linear\nelse {\n    for (let i = 0; i < calibration.length - 1; i++) {\n\n        const p1 = calibration[i];\n        const p2 = calibration[i + 1];\n\n        if (distance >= p1.d && distance <= p2.d) {\n\n            volume =\n                p1.v +\n                (p2.v - p1.v) *\n                (distance - p1.d) /\n                (p2.d - p1.d);\n\n            break;\n        }\n    }\n}\n\n// Bulatkan volume\nvolume = Math.round(volume);\n\n// Masukkan hasil sebagai field \"value\"\nmsg.payload.value = volume;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 470,
        "y": 400,
        "wires": [
            [
                "88430f30a82c0b10",
                "93fdb09f23252739",
                "f28aca3e61b3d89a"
            ]
        ]
    },
    {
        "id": "88430f30a82c0b10",
        "type": "function",
        "z": "738d9d88112e823c",
        "name": "Volume dalam bentuk persen",
        "func": "// Ambil volume dari hasil konversi sebelumnya\nconst volume = Number(msg.payload.value);\n\n// Kapasitas maksimum wadah\nconst maxVolume = 1000;\n\n// Validasi\nif (isNaN(volume)) {\n    node.error(\"value bukan angka\", msg);\n    return null;\n}\n\n// Hitung persentase\nlet persen = (volume / maxVolume) * 100;\n\n// Batasi 0–100%\npersen = Math.max(0, Math.min(100, persen));\n\n// Bulatkan 2 angka di belakang koma\nmsg.payload.persen = Number(persen.toFixed(2));\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
